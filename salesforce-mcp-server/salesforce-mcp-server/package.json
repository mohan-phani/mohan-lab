{
  "name": "salesforce-mcp-server",
  "version": "1.0.0",
  "description": "Universal Salesforce MCP Server with query guardrails, circuit breaker, audit logging, and dual transport (stdio + HTTP)",
  "main": "dist/index.js",
  "bin": {
    "salesforce-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "salesforce",
    "model-context-protocol",
    "claude",
    "ai",
    "soql",
    "crm"
  ],
  "author": "mohan-phani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohan-phani/mohan-lab"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "jsforce": "^2.0.0-beta.32",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "express": "^4.19.2",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^9.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

{
  "name": "salesforce-mcp-server",
  "version": "2.0.0",
  "description": "Salesforce MCP Server with OAuth 2.0, query guardrails, circuit breaker, and dual transport (stdio + HTTP)",
  "main": "dist/index.js",
  "bin": {
    "salesforce-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "npx esbuild src/index.ts --bundle --platform=node --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "auth": "node dist/index.js --auth",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["mcp", "salesforce", "model-context-protocol", "claude", "ai", "soql", "crm", "oauth"],
  "author": "mohan-phani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohan-phani/mohan-lab"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "jsforce": "^3.0.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "express": "^4.19.2",
    "node-cache": "^5.1.2",
    "open": "^10.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": ["**/tests/**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts", "!src/index.ts"],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
